{
  "name": "tuitionlink-bd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TuitionLink BD - free tuition board and tutor directory for Bangladesh",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build:app": "vite build",
    "build:server": "node scripts/build-worker.mjs",
    "build": "npm run typecheck && npm run build:app && npm run build:server",
    "dev": "npm run build && wrangler dev --port 8787",
    "db:seed": "wrangler d1 execute DB --local --file seed/seed.sql"
  },
  "dependencies": {
    "@freebuff/auth": "^0.1.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^25.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
